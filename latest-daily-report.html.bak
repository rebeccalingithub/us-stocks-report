<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>美股大盘报告 | 2026-05-18</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); min-height: 100vh; padding: 20px; line-height: 1.6; }
        .container { max-width: 1200px; margin: 0 auto; background: white; border-radius: 20px; box-shadow: 0 20px 60px rgba(0,0,0,0.3); overflow: hidden; }
        .header { background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%); color: white; padding: 40px; text-align: center; }
        .header h1 { font-size: 2.5em; background: linear-gradient(90deg, #00d4ff, #7b2ff7); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
        .section { padding: 30px 40px; border-bottom: 1px solid #eee; }
        .section-title { font-size: 1.6em; font-weight: 700; color: #1a1a2e; margin-bottom: 25px; display: flex; align-items: center; gap: 12px; }
        .market-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px; }
        .market-card { background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%); border-radius: 15px; padding: 25px; }
        .market-card.positive { background: linear-gradient(135deg, #d4fc79 0%, #96e6a1 100%); }
        .market-card.negative { background: linear-gradient(135deg, #ffecd2 0%, #fcb69f 100%); }
        .market-card .ticker { font-size: 1.8em; font-weight: 800; color: #1a1a2e; }
        .market-card .price { font-size: 2em; font-weight: 700; }
        .market-card.positive .change { color: #2d8a4e; font-weight: 600; }
        .market-card.negative .change { color: #d32f2f; font-weight: 600; }
        table { width: 100%; border-collapse: collapse; margin-top: 15px; }
        th, td { padding: 12px 15px; text-align: left; border-bottom: 1px solid #eee; }
        th { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; }
        .event-card { background: #f8f9fa; border-radius: 12px; padding: 20px; margin-bottom: 15px; border-left: 4px solid #667eea; }
        .fg-card { background: linear-gradient(135deg, #ffecd2 0%, #fcb69f 100%); border-radius: 20px; padding: 30px; text-align: center; }
        .fg-value { font-size: 5em; font-weight: 900; color: #1a1a2e; }
        .fg-label { font-size: 1.5em; font-weight: 700; margin-top: 10px; color: #d32f2f; }
        .calendar-day { background: #f8f9fa; border-radius: 10px; padding: 15px; margin-bottom: 12px; }
        .calendar-day .date { font-weight: 700; color: #667eea; margin-bottom: 10px; }
        .footer { background: #1a1a2e; color: white; text-align: center; padding: 25px; }
        .win-rate { display: inline-block; background: #4caf50; color: white; padding: 3px 10px; border-radius: 12px; font-size: 0.85em; font-weight: 600; }
        .odds { display: inline-block; background: #9c27b0; color: white; padding: 3px 10px; border-radius: 12px; font-size: 0.85em; font-weight: 600; margin-left: 8px; }
    </style>
</head>
